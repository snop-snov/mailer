# Token from @BotFather
BOT_TOKEN=123456:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Chat where moderators see submissions and press Approve/Reject.
# Negative id for groups/supergroups, e.g. -1001234567890
MODERATION_CHAT_ID=-1001234567890

# Chat/channel approved messages are published to
TARGET_CHAT_ID=-1009876543210

# --- Webhook mode (default) ---
# Public HTTPS base URL that your proxy/PaaS exposes
WEBHOOK_HOST=https://bot.example.com
# Keep this path secret-ish; it is part of the webhook URL
WEBHOOK_PATH=/webhook/ab12cd34ef56
# Sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header and verified by the bot
WEBHOOK_SECRET_TOKEN=change-me-to-a-long-random-string

# Where the aiohttp server listens behind the proxy
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080
